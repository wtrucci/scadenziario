# ============================================================
# Scadenziario — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------

# Random secret used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-64-char-hex-string

# Set to "true" only during local development (enables debug pages).
DEBUG=false

# Send the session cookie only over HTTPS. Keep "false" for local http
# development; set "true" in production behind a TLS-terminating proxy.
SESSION_HTTPS_ONLY=false

# ----------------------------------------------------------
# Database
# ----------------------------------------------------------

# Path to the SQLite file. The directory must exist and be writable.
# In Docker, point this to the mounted volume (e.g. sqlite:///./data/scadenziario.db).
DATABASE_URL=sqlite:///./data/scadenziario.db

# ----------------------------------------------------------
# Telegram notifications
# ----------------------------------------------------------

# Token obtained from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Chat ID that receives notifications (group or personal).
# For a group, prefix with '-' (e.g. -1001234567890).
# To target a specific topic in a supergroup with topics enabled, append
# ":TOPIC_ID" (e.g. -1001234567890:42). Without it, messages go to the chat
# as normal (works for a private chat, a group, or a channel).
TELEGRAM_CHAT_ID=-1001234567890

# ----------------------------------------------------------
# Notification scheduler
# ----------------------------------------------------------

# How often the scheduler checks for upcoming expirations (in minutes).
NOTIFICATION_CHECK_INTERVAL_MINUTES=60

# ----------------------------------------------------------
# Timezone
# ----------------------------------------------------------

# Used by APScheduler and for display. Must be a valid tz database name.
TZ=Europe/Rome

# ----------------------------------------------------------
# First admin account (used only on first startup if no users exist)
# ----------------------------------------------------------

FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=change-this-password
